<?xml version="1.0" encoding="UTF-8"?>
<graphml xmlns="http://graphml.graphdrawing.org/graphml"
         xmlns:y="http://www.yworks.com/xml/graphml">
  <key id="d6"  for="node" yfiles.type="nodegraphics"/>
  <key id="d10" for="edge" yfiles.type="edgegraphics"/>
  <graph id="G" edgedefault="directed">

    <!-- Input  cx=516 -->
    <node id="n8">
      <data key="d6">
        <y:ShapeNode>
          <y:Geometry x="411.00" y="59.66" width="210" height="84"/>
          <y:Fill color="#E8E8E8" transparent="false"/>
          <y:BorderStyle type="line" width="1.5" color="#000000"/>
          <y:NodeLabel fontFamily="Arial" fontSize="15" fontStyle="plain"
                       alignment="center">Loads,
elastic properties</y:NodeLabel>
          <y:Shape type="diamond"/>
        </y:ShapeNode>
      </data>
    </node>

    <!-- BMI: initialize  cx=516 -->
    <node id="n7">
      <data key="d6">
        <y:ShapeNode>
          <y:Geometry x="442.00" y="203.89" width="148" height="60"/>
          <y:Fill color="#E8E8E8" transparent="false"/>
          <y:BorderStyle type="line" width="2.5" color="#000000"/>
          <y:NodeLabel fontFamily="Arial" fontSize="15" fontStyle="bold"
                       alignment="center">Initialize
(1D or 2D)</y:NodeLabel>
          <y:Shape type="ellipse"/>
        </y:ShapeNode>
      </data>
    </node>

    <!-- Background band: solution method row
         SAS_NG cx=200 w=215 → left=92.5; FD cx=825 w=170 → right=910 -->
    <node id="bg_methods">
      <data key="d6">
        <y:ShapeNode>
          <y:Geometry x="80.00" y="311.66" width="840.00" height="100.00"/>
          <y:Fill color="#F2F2F2" transparent="false"/>
          <y:BorderStyle type="line" width="1.0" color="#BBBBBB"/>
          <y:NodeLabel fontFamily="Arial" fontSize="11" fontStyle="italic"
                       alignment="left" textColor="#888888"
                       modelName="internal" modelPosition="tl">Solution Method</y:NodeLabel>
          <y:Shape type="roundrectangle"/>
        </y:ShapeNode>
      </data>
    </node>

    <!-- Solution methods (left→right: SAS_NG, SAS, FFT, FD) -->
    <node id="n3">
      <data key="d6">
        <y:ShapeNode>
          <y:Geometry x="92.50" y="323.66" width="215" height="76"/>
          <y:Fill color="#E8E8E8" transparent="false"/>
          <y:BorderStyle type="line" width="1.5" color="#000000"/>
          <y:NodeLabel fontFamily="Arial" fontSize="15" fontStyle="plain"
                       alignment="center">Superposition of
Analytical Solutions,
no grid (SAS_NG)</y:NodeLabel>
          <y:Shape type="roundrectangle"/>
        </y:ShapeNode>
      </data>
    </node>

    <node id="n2">
      <data key="d6">
        <y:ShapeNode>
          <y:Geometry x="347.50" y="323.66" width="205" height="76"/>
          <y:Fill color="#E8E8E8" transparent="false"/>
          <y:BorderStyle type="line" width="1.5" color="#000000"/>
          <y:NodeLabel fontFamily="Arial" fontSize="15" fontStyle="plain"
                       alignment="center">Superposition of
Analytical Solutions
(SAS)</y:NodeLabel>
          <y:Shape type="roundrectangle"/>
        </y:ShapeNode>
      </data>
    </node>

    <!-- FFT cx=660: left=600, SAS right=552.5 → 47.5px gap -->
    <node id="n4">
      <data key="d6">
        <y:ShapeNode>
          <y:Geometry x="600.00" y="323.66" width="120" height="76"/>
          <y:Fill color="#E8E8E8" transparent="false"/>
          <y:BorderStyle type="line" width="1.5" color="#000000"/>
          <y:NodeLabel fontFamily="Arial" fontSize="15" fontStyle="plain"
                       alignment="center">Spectral
(FFT)</y:NodeLabel>
          <y:Shape type="roundrectangle"/>
        </y:ShapeNode>
      </data>
    </node>

    <!-- FD cx=825: left=740, right=910. FFT right=720 → 20px gap. -->
    <node id="n1">
      <data key="d6">
        <y:ShapeNode>
          <y:Geometry x="740.00" y="323.66" width="170" height="76"/>
          <y:Fill color="#E8E8E8" transparent="false"/>
          <y:BorderStyle type="line" width="1.5" color="#000000"/>
          <y:NodeLabel fontFamily="Arial" fontSize="15" fontStyle="plain"
                       alignment="center">Finite Difference
(FD)</y:NodeLabel>
          <y:Shape type="roundrectangle"/>
        </y:ShapeNode>
      </data>
    </node>

    <!-- Single BC band.
         Left: bc_nol left=255 − 10=245; Right: bc_0ms right=1065 + 10=1075.
         Top: 15px above Row 1 (y=459.45). Bottom: 10px below Row 2 (bottom=619.45). -->
    <node id="bg_all_bcs">
      <data key="d6">
        <y:ShapeNode>
          <y:Geometry x="245.00" y="444.00" width="830.00" height="186.00"/>
          <y:Fill color="#F2F2F2" transparent="false"/>
          <y:BorderStyle type="line" width="1.0" color="#BBBBBB"/>
          <y:NodeLabel fontFamily="Arial" fontSize="11" fontStyle="italic"
                       alignment="left" textColor="#888888"
                       modelName="internal" modelPosition="tl">Boundary Condition</y:NodeLabel>
          <y:Shape type="roundrectangle"/>
        </y:ShapeNode>
      </data>
    </node>

    <!-- Row 1 BCs — spine column at cx=516 aligns bc_per with Init and Run.
         bc_per  cx=516: left=471,  right=561.  (FFT→left 144px; FD→left 309px)
         bc_0ds  cx=660: left=590,  right=730.  gap from bc_per: 29px.
         bc_mir  cx=800: left=760,  right=840.  gap from bc_0ds: 30px.
         bc_0ss  cx=900: left=852.5,right=947.5. gap from bc_mir: 12.5px.
         bc_0ms  cx=1010:left=955,  right=1065. gap from bc_0ss: 7.5px.
         bc_nol_pad (Row 2, cx=588) = midpoint(516,660): 72px each side — perfect pyramid. -->
    <node id="bc_per">
      <data key="d6">
        <y:ShapeNode>
          <y:Geometry x="471.00" y="459.45" width="90" height="60"/>
          <y:Fill color="#E8E8E8" transparent="false"/>
          <y:BorderStyle type="line" width="1.5" color="#000000"/>
          <y:NodeLabel fontFamily="Arial" fontSize="15" fontStyle="plain"
                       alignment="center">Periodic</y:NodeLabel>
          <y:Shape type="roundrectangle"/>
        </y:ShapeNode>
      </data>
    </node>

    <node id="bc_0ds">
      <data key="d6">
        <y:ShapeNode>
          <y:Geometry x="590.00" y="459.45" width="140" height="60"/>
          <y:Fill color="#E8E8E8" transparent="false"/>
          <y:BorderStyle type="line" width="1.5" color="#000000"/>
          <y:NodeLabel fontFamily="Arial" fontSize="15" fontStyle="plain"
                       alignment="center">0Displacement
0Slope</y:NodeLabel>
          <y:Shape type="roundrectangle"/>
        </y:ShapeNode>
      </data>
    </node>

    <node id="bc_mir">
      <data key="d6">
        <y:ShapeNode>
          <y:Geometry x="760.00" y="459.45" width="80" height="60"/>
          <y:Fill color="#E8E8E8" transparent="false"/>
          <y:BorderStyle type="line" width="1.5" color="#000000"/>
          <y:NodeLabel fontFamily="Arial" fontSize="15" fontStyle="plain"
                       alignment="center">Mirror</y:NodeLabel>
          <y:Shape type="roundrectangle"/>
        </y:ShapeNode>
      </data>
    </node>

    <node id="bc_0ss">
      <data key="d6">
        <y:ShapeNode>
          <y:Geometry x="852.50" y="459.45" width="95" height="60"/>
          <y:Fill color="#E8E8E8" transparent="false"/>
          <y:BorderStyle type="line" width="1.5" color="#000000"/>
          <y:NodeLabel fontFamily="Arial" fontSize="15" fontStyle="plain"
                       alignment="center">0Slope
0Shear</y:NodeLabel>
          <y:Shape type="roundrectangle"/>
        </y:ShapeNode>
      </data>
    </node>

    <node id="bc_0ms">
      <data key="d6">
        <y:ShapeNode>
          <y:Geometry x="955.00" y="459.45" width="110" height="60"/>
          <y:Fill color="#E8E8E8" transparent="false"/>
          <y:BorderStyle type="line" width="1.5" color="#000000"/>
          <y:NodeLabel fontFamily="Arial" fontSize="15" fontStyle="plain"
                       alignment="center">0Moment
0Shear</y:NodeLabel>
          <y:Shape type="roundrectangle"/>
        </y:ShapeNode>
      </data>
    </node>

    <!-- Row 2: NoOutsideLoads exact (cx=325, between SAS_NG 200 and SAS 450)
                NoOutsideLoads via padding (cx=588, midpoint of bc_per 516 and bc_0ds 660). -->
    <node id="bc_nol">
      <data key="d6">
        <y:ShapeNode>
          <y:Geometry x="255.00" y="559.45" width="140" height="60"/>
          <y:Fill color="#E8E8E8" transparent="false"/>
          <y:BorderStyle type="line" width="1.5" color="#000000"/>
          <y:NodeLabel fontFamily="Arial" fontSize="15" fontStyle="plain"
                       alignment="center">NoOutsideLoads</y:NodeLabel>
          <y:Shape type="roundrectangle"/>
        </y:ShapeNode>
      </data>
    </node>

    <node id="bc_nol_pad">
      <data key="d6">
        <y:ShapeNode>
          <y:Geometry x="523.00" y="559.45" width="130" height="60"/>
          <y:Fill color="#E8E8E8" transparent="false"/>
          <y:BorderStyle type="line" width="1.5" color="#000000"/>
          <y:NodeLabel fontFamily="Arial" fontSize="15" fontStyle="plain"
                       alignment="center">NoOutsideLoads
(via padding)</y:NodeLabel>
          <y:Shape type="roundrectangle"/>
        </y:ShapeNode>
      </data>
    </node>

    <!-- BMI: run — cx=516 aligns with Input, Init, bc_per, Finalize (straight spine).
         bc_per→Run is a straight vertical. BCs→Run bus y=648.45. -->
    <node id="n0">
      <data key="d6">
        <y:ShapeNode>
          <y:Geometry x="461.00" y="677.45" width="110" height="44"/>
          <y:Fill color="#E8E8E8" transparent="false"/>
          <y:BorderStyle type="line" width="2.5" color="#000000"/>
          <y:NodeLabel fontFamily="Arial" fontSize="15" fontStyle="bold"
                       alignment="center">Run</y:NodeLabel>
          <y:Shape type="ellipse"/>
        </y:ShapeNode>
      </data>
    </node>

    <!-- BMI: finalize  cx=516 -->
    <node id="n14">
      <data key="d6">
        <y:ShapeNode>
          <y:Geometry x="461.00" y="778.56" width="110" height="44"/>
          <y:Fill color="#E8E8E8" transparent="false"/>
          <y:BorderStyle type="line" width="2.5" color="#000000"/>
          <y:NodeLabel fontFamily="Arial" fontSize="15" fontStyle="bold"
                       alignment="center">Finalize</y:NodeLabel>
          <y:Shape type="ellipse"/>
        </y:ShapeNode>
      </data>
    </node>

    <!-- ── Edges ─────────────────────────────────────────────────────────────── -->

    <!-- Input → Initialize (straight vertical, both cx=516) -->
    <edge id="e0" source="n8" target="n7">
      <data key="d10"><y:PolyLineEdge>
        <y:LineStyle type="line" width="1.5" color="#000000"/>
        <y:Arrows source="none" target="standard"/>
      </y:PolyLineEdge></data>
    </edge>

    <!-- Initialize (cx=516) → solution methods
         bus y = (263.89 + 323.66) / 2 = 293.78 -->
    <edge id="e1" source="n7" target="n3">
      <data key="d10"><y:PolyLineEdge>
        <y:LineStyle type="line" width="1.5" color="#000000"/>
        <y:Arrows source="none" target="standard"/>
        <y:Point x="516.00" y="293.78"/>
        <y:Point x="200.00" y="293.78"/>
      </y:PolyLineEdge></data>
    </edge>
    <edge id="e2" source="n7" target="n2">
      <data key="d10"><y:PolyLineEdge>
        <y:LineStyle type="line" width="1.5" color="#000000"/>
        <y:Arrows source="none" target="standard"/>
        <y:Point x="516.00" y="293.78"/>
        <y:Point x="450.00" y="293.78"/>
      </y:PolyLineEdge></data>
    </edge>
    <edge id="e3" source="n7" target="n4">
      <data key="d10"><y:PolyLineEdge>
        <y:LineStyle type="line" width="1.5" color="#000000"/>
        <y:Arrows source="none" target="standard"/>
        <y:Point x="516.00" y="293.78"/>
        <y:Point x="660.00" y="293.78"/>
      </y:PolyLineEdge></data>
    </edge>
    <edge id="e4" source="n7" target="n1">
      <data key="d10"><y:PolyLineEdge>
        <y:LineStyle type="line" width="1.5" color="#000000"/>
        <y:Arrows source="none" target="standard"/>
        <y:Point x="516.00" y="293.78"/>
        <y:Point x="825.00" y="293.78"/>
      </y:PolyLineEdge></data>
    </edge>

    <!-- Solution methods → BCs
         Methods→BCs bus y = (399.66 + 459.45) / 2 = 429.56

         SAS_NG (200) and SAS (450) converge on bc_nol (325): opposite dirs.
         FFT (660) →left→ bc_per (516): 144px.
         FD  (825) →left→ bc_per (516): 309px. Shared segment 516–660 with FFT→bc_per.
         FD  (825) →left→ bc_0ds (660): 165px.
         FD  (825) →left→ bc_mir (800): 25px.
         FD  (825) →right→ bc_0ss (900): 75px.
         FD  (825) →right→ bc_0ms (1010): 185px. -->
    <edge id="e5" source="n3" target="bc_nol">
      <data key="d10"><y:PolyLineEdge>
        <y:LineStyle type="line" width="1.5" color="#000000"/>
        <y:Arrows source="none" target="standard"/>
        <y:Point x="200.00" y="429.56"/>
        <y:Point x="325.00" y="429.56"/>
      </y:PolyLineEdge></data>
    </edge>
    <edge id="e6" source="n2" target="bc_nol">
      <data key="d10"><y:PolyLineEdge>
        <y:LineStyle type="line" width="1.5" color="#000000"/>
        <y:Arrows source="none" target="standard"/>
        <y:Point x="450.00" y="429.56"/>
        <y:Point x="325.00" y="429.56"/>
      </y:PolyLineEdge></data>
    </edge>
    <edge id="e7" source="n4" target="bc_per">
      <data key="d10"><y:PolyLineEdge>
        <y:LineStyle type="line" width="1.5" color="#000000"/>
        <y:Arrows source="none" target="standard"/>
        <y:Point x="660.00" y="429.56"/>
        <y:Point x="516.00" y="429.56"/>
      </y:PolyLineEdge></data>
    </edge>
    <edge id="e8" source="n1" target="bc_per">
      <data key="d10"><y:PolyLineEdge>
        <y:LineStyle type="line" width="1.5" color="#000000"/>
        <y:Arrows source="none" target="standard"/>
        <y:Point x="825.00" y="429.56"/>
        <y:Point x="516.00" y="429.56"/>
      </y:PolyLineEdge></data>
    </edge>
    <edge id="e9" source="n1" target="bc_0ds">
      <data key="d10"><y:PolyLineEdge>
        <y:LineStyle type="line" width="1.5" color="#000000"/>
        <y:Arrows source="none" target="standard"/>
        <y:Point x="825.00" y="429.56"/>
        <y:Point x="660.00" y="429.56"/>
      </y:PolyLineEdge></data>
    </edge>
    <edge id="e10" source="n1" target="bc_mir">
      <data key="d10"><y:PolyLineEdge>
        <y:LineStyle type="line" width="1.5" color="#000000"/>
        <y:Arrows source="none" target="standard"/>
        <y:Point x="825.00" y="429.56"/>
        <y:Point x="800.00" y="429.56"/>
      </y:PolyLineEdge></data>
    </edge>
    <edge id="e11" source="n1" target="bc_0ss">
      <data key="d10"><y:PolyLineEdge>
        <y:LineStyle type="line" width="1.5" color="#000000"/>
        <y:Arrows source="none" target="standard"/>
        <y:Point x="825.00" y="429.56"/>
        <y:Point x="900.00" y="429.56"/>
      </y:PolyLineEdge></data>
    </edge>
    <edge id="e12" source="n1" target="bc_0ms">
      <data key="d10"><y:PolyLineEdge>
        <y:LineStyle type="line" width="1.5" color="#000000"/>
        <y:Arrows source="none" target="standard"/>
        <y:Point x="825.00" y="429.56"/>
        <y:Point x="1010.00" y="429.56"/>
      </y:PolyLineEdge></data>
    </edge>

    <!-- Row 1 BCs → bc_nol_pad (Row 2)
         Row1→Row2 bus y = (519.45 + 559.45) / 2 = 539.45
         bc_per (516) →right 72px→ bc_nol_pad (588).
         bc_0ds (660) →left  72px→ bc_nol_pad (588). Perfectly symmetric pyramid. -->
    <edge id="e20" source="bc_per" target="bc_nol_pad">
      <data key="d10"><y:PolyLineEdge>
        <y:LineStyle type="line" width="1.5" color="#000000"/>
        <y:Arrows source="none" target="standard"/>
        <y:Point x="516.00" y="539.45"/>
        <y:Point x="588.00" y="539.45"/>
      </y:PolyLineEdge></data>
    </edge>
    <edge id="e21" source="bc_0ds" target="bc_nol_pad">
      <data key="d10"><y:PolyLineEdge>
        <y:LineStyle type="line" width="1.5" color="#000000"/>
        <y:Arrows source="none" target="standard"/>
        <y:Point x="660.00" y="539.45"/>
        <y:Point x="588.00" y="539.45"/>
      </y:PolyLineEdge></data>
    </edge>

    <!-- BCs → Run  (Run cx=516; bus y=648.45)
         bc_per (516) → Run (516): straight vertical — no bends.
         bc_nol_pad (588) →left 72px→ Run (516).
         bc_nol (325)  →right→ Run (516).
         All others →left→ Run (516). -->
    <edge id="e14" source="bc_per" target="n0">
      <data key="d10"><y:PolyLineEdge>
        <y:LineStyle type="line" width="1.5" color="#000000"/>
        <y:Arrows source="none" target="standard"/>
      </y:PolyLineEdge></data>
    </edge>
    <edge id="e22" source="bc_nol_pad" target="n0">
      <data key="d10"><y:PolyLineEdge>
        <y:LineStyle type="line" width="1.5" color="#000000"/>
        <y:Arrows source="none" target="standard"/>
        <y:Point x="588.00" y="648.45"/>
        <y:Point x="516.00" y="648.45"/>
      </y:PolyLineEdge></data>
    </edge>
    <edge id="e13" source="bc_nol" target="n0">
      <data key="d10"><y:PolyLineEdge>
        <y:LineStyle type="line" width="1.5" color="#000000"/>
        <y:Arrows source="none" target="standard"/>
        <y:Point x="325.00" y="648.45"/>
        <y:Point x="516.00" y="648.45"/>
      </y:PolyLineEdge></data>
    </edge>
    <edge id="e18" source="bc_0ds" target="n0">
      <data key="d10"><y:PolyLineEdge>
        <y:LineStyle type="line" width="1.5" color="#000000"/>
        <y:Arrows source="none" target="standard"/>
        <y:Point x="660.00" y="648.45"/>
        <y:Point x="516.00" y="648.45"/>
      </y:PolyLineEdge></data>
    </edge>
    <edge id="e15" source="bc_mir" target="n0">
      <data key="d10"><y:PolyLineEdge>
        <y:LineStyle type="line" width="1.5" color="#000000"/>
        <y:Arrows source="none" target="standard"/>
        <y:Point x="800.00" y="648.45"/>
        <y:Point x="516.00" y="648.45"/>
      </y:PolyLineEdge></data>
    </edge>
    <edge id="e16" source="bc_0ss" target="n0">
      <data key="d10"><y:PolyLineEdge>
        <y:LineStyle type="line" width="1.5" color="#000000"/>
        <y:Arrows source="none" target="standard"/>
        <y:Point x="900.00" y="648.45"/>
        <y:Point x="516.00" y="648.45"/>
      </y:PolyLineEdge></data>
    </edge>
    <edge id="e17" source="bc_0ms" target="n0">
      <data key="d10"><y:PolyLineEdge>
        <y:LineStyle type="line" width="1.5" color="#000000"/>
        <y:Arrows source="none" target="standard"/>
        <y:Point x="1010.00" y="648.45"/>
        <y:Point x="516.00" y="648.45"/>
      </y:PolyLineEdge></data>
    </edge>

    <!-- Run → Finalize (straight vertical, both cx=516) -->
    <edge id="e19" source="n0" target="n14">
      <data key="d10"><y:PolyLineEdge>
        <y:LineStyle type="line" width="1.5" color="#000000"/>
        <y:Arrows source="none" target="standard"/>
      </y:PolyLineEdge></data>
    </edge>

  </graph>
</graphml>
