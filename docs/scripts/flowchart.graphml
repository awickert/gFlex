<?xml version="1.0" encoding="UTF-8"?>
<graphml xmlns="http://graphml.graphdrawing.org/graphml"
         xmlns:y="http://www.yworks.com/xml/graphml">
  <key id="d6"  for="node" yfiles.type="nodegraphics"/>
  <key id="d10" for="edge" yfiles.type="edgegraphics"/>
  <graph id="G" edgedefault="directed">

    <!-- Spine cx=516: Input, Init, Run, Finalize all share this column. -->

    <!-- Input  cx=516 -->
    <node id="n8">
      <data key="d6">
        <y:ShapeNode>
          <y:Geometry x="411.00" y="59.66" width="210" height="84"/>
          <y:Fill color="#E8E8E8" transparent="false"/>
          <y:BorderStyle type="line" width="1.5" color="#000000"/>
          <y:NodeLabel fontFamily="Arial" fontSize="15" fontStyle="plain"
                       alignment="center">Loads,
elastic properties</y:NodeLabel>
          <y:Shape type="diamond"/>
        </y:ShapeNode>
      </data>
    </node>

    <!-- BMI: initialize  cx=516 -->
    <node id="n7">
      <data key="d6">
        <y:ShapeNode>
          <y:Geometry x="442.00" y="203.89" width="148" height="60"/>
          <y:Fill color="#E8E8E8" transparent="false"/>
          <y:BorderStyle type="line" width="2.5" color="#000000"/>
          <y:NodeLabel fontFamily="Arial" fontSize="15" fontStyle="bold"
                       alignment="center">Initialize
(1D or 2D)</y:NodeLabel>
          <y:Shape type="ellipse"/>
        </y:ShapeNode>
      </data>
    </node>

    <!-- Background band: solution method row
         SAS_NG cx=200 left=92.5; FD cx=825 right=910 -->
    <node id="bg_methods">
      <data key="d6">
        <y:ShapeNode>
          <y:Geometry x="60.00" y="311.66" width="860.00" height="100.00"/>
          <y:Fill color="#F2F2F2" transparent="false"/>
          <y:BorderStyle type="line" width="1.0" color="#BBBBBB"/>
          <y:NodeLabel fontFamily="Arial" fontSize="11" fontStyle="italic"
                       alignment="left" textColor="#888888"
                       modelName="internal" modelPosition="tl">Solution Method</y:NodeLabel>
          <y:Shape type="roundrectangle"/>
        </y:ShapeNode>
      </data>
    </node>

    <!-- Solution methods (left→right: SAS_NG, SAS, FFT, FD) -->
    <node id="n3">
      <data key="d6">
        <y:ShapeNode>
          <y:Geometry x="92.50" y="323.66" width="215" height="76"/>
          <y:Fill color="#E8E8E8" transparent="false"/>
          <y:BorderStyle type="line" width="1.5" color="#000000"/>
          <y:NodeLabel fontFamily="Arial" fontSize="15" fontStyle="plain"
                       alignment="center">Superposition of
Analytical Solutions,
no grid (SAS_NG)</y:NodeLabel>
          <y:Shape type="roundrectangle"/>
        </y:ShapeNode>
      </data>
    </node>

    <node id="n2">
      <data key="d6">
        <y:ShapeNode>
          <y:Geometry x="347.50" y="323.66" width="205" height="76"/>
          <y:Fill color="#E8E8E8" transparent="false"/>
          <y:BorderStyle type="line" width="1.5" color="#000000"/>
          <y:NodeLabel fontFamily="Arial" fontSize="15" fontStyle="plain"
                       alignment="center">Superposition of
Analytical Solutions
(SAS)</y:NodeLabel>
          <y:Shape type="roundrectangle"/>
        </y:ShapeNode>
      </data>
    </node>

    <node id="n4">
      <data key="d6">
        <y:ShapeNode>
          <y:Geometry x="600.00" y="323.66" width="120" height="76"/>
          <y:Fill color="#E8E8E8" transparent="false"/>
          <y:BorderStyle type="line" width="1.5" color="#000000"/>
          <y:NodeLabel fontFamily="Arial" fontSize="15" fontStyle="plain"
                       alignment="center">Spectral
(FFT)</y:NodeLabel>
          <y:Shape type="roundrectangle"/>
        </y:ShapeNode>
      </data>
    </node>

    <!-- FD cx=825; sits between bc_mir (left) and bc_0ss (right) -->
    <node id="n1">
      <data key="d6">
        <y:ShapeNode>
          <y:Geometry x="740.00" y="323.66" width="170" height="76"/>
          <y:Fill color="#E8E8E8" transparent="false"/>
          <y:BorderStyle type="line" width="1.5" color="#000000"/>
          <y:NodeLabel fontFamily="Arial" fontSize="15" fontStyle="plain"
                       alignment="center">Finite Difference
(FD)</y:NodeLabel>
          <y:Shape type="roundrectangle"/>
        </y:ShapeNode>
      </data>
    </node>

    <!-- Single BC band.
         Row 1 BCs have uniform 20 px gaps and content-fitted widths.
         bc_per  cx=516  w=90   left=471  right=561
         bc_0ds  cx=646  w=130  left=581  right=711   gap from bc_per: 20 px
         bc_mir  cx=771  w=80   left=731  right=811   gap from bc_0ds: 20 px
         bc_0ss  cx=871  w=80   left=831  right=911   gap from bc_mir: 20 px
         bc_0ms  cx=976  w=90   left=931  right=1021  gap from bc_0ss: 20 px
         FD (825) sits between bc_mir (771) and bc_0ss (871).

         bc_nol_pad  cx=581  w=160  h=70  left=501  right=661
           midpoint of bc_per (516) and bc_0ds (646): (516+646)/2 = 581
           Width 160 fills the visual space generously without routing conflicts:
           bc_per→Run routes LEFT of bc_nol_pad (arm at x=485 < left=501)
           bc_0ds→Run routes RIGHT of bc_nol_pad (arm at x=673 > right=661)

         Band left:  bc_nol left=260  − 30 = 230  (extra 20 px for swim label strip)
         Band right: bc_0ms right=1021 + 10 = 1031  →  w=801
         Band top:   bc_per top=459.45 − 15 = 444
         Band bottom: bc_nol_pad bottom=629.45 + 10 = 639.45 → h=196  -->
    <node id="bg_all_bcs">
      <data key="d6">
        <y:ShapeNode>
          <y:Geometry x="230.00" y="444.00" width="801.00" height="196.00"/>
          <y:Fill color="#F2F2F2" transparent="false"/>
          <y:BorderStyle type="line" width="1.0" color="#BBBBBB"/>
          <y:NodeLabel fontFamily="Arial" fontSize="11" fontStyle="italic"
                       alignment="left" textColor="#888888"
                       modelName="internal" modelPosition="tl">Boundary Conditions</y:NodeLabel>
          <y:Shape type="roundrectangle"/>
        </y:ShapeNode>
      </data>
    </node>

    <!-- BC Row 1 -->
    <node id="bc_per">
      <data key="d6">
        <y:ShapeNode>
          <y:Geometry x="471.00" y="459.45" width="90" height="60"/>
          <y:Fill color="#E8E8E8" transparent="false"/>
          <y:BorderStyle type="line" width="1.5" color="#000000"/>
          <y:NodeLabel fontFamily="Arial" fontSize="15" fontStyle="plain"
                       alignment="center">Periodic</y:NodeLabel>
          <y:Shape type="roundrectangle"/>
        </y:ShapeNode>
      </data>
    </node>

    <node id="bc_0ds">
      <data key="d6">
        <y:ShapeNode>
          <y:Geometry x="581.00" y="459.45" width="130" height="60"/>
          <y:Fill color="#E8E8E8" transparent="false"/>
          <y:BorderStyle type="line" width="1.5" color="#000000"/>
          <y:NodeLabel fontFamily="Arial" fontSize="15" fontStyle="plain"
                       alignment="center">0Displacement
0Slope</y:NodeLabel>
          <y:Shape type="roundrectangle"/>
        </y:ShapeNode>
      </data>
    </node>

    <node id="bc_mir">
      <data key="d6">
        <y:ShapeNode>
          <y:Geometry x="731.00" y="459.45" width="80" height="60"/>
          <y:Fill color="#E8E8E8" transparent="false"/>
          <y:BorderStyle type="line" width="1.5" color="#000000"/>
          <y:NodeLabel fontFamily="Arial" fontSize="15" fontStyle="plain"
                       alignment="center">Mirror</y:NodeLabel>
          <y:Shape type="roundrectangle"/>
        </y:ShapeNode>
      </data>
    </node>

    <node id="bc_0ss">
      <data key="d6">
        <y:ShapeNode>
          <y:Geometry x="831.00" y="459.45" width="80" height="60"/>
          <y:Fill color="#E8E8E8" transparent="false"/>
          <y:BorderStyle type="line" width="1.5" color="#000000"/>
          <y:NodeLabel fontFamily="Arial" fontSize="15" fontStyle="plain"
                       alignment="center">0Slope
0Shear</y:NodeLabel>
          <y:Shape type="roundrectangle"/>
        </y:ShapeNode>
      </data>
    </node>

    <node id="bc_0ms">
      <data key="d6">
        <y:ShapeNode>
          <y:Geometry x="931.00" y="459.45" width="90" height="60"/>
          <y:Fill color="#E8E8E8" transparent="false"/>
          <y:BorderStyle type="line" width="1.5" color="#000000"/>
          <y:NodeLabel fontFamily="Arial" fontSize="15" fontStyle="plain"
                       alignment="center">0Moment
0Shear</y:NodeLabel>
          <y:Shape type="roundrectangle"/>
        </y:ShapeNode>
      </data>
    </node>

    <!-- BC Row 2 -->
    <node id="bc_nol">
      <data key="d6">
        <y:ShapeNode>
          <y:Geometry x="260.00" y="559.45" width="130" height="60"/>
          <y:Fill color="#E8E8E8" transparent="false"/>
          <y:BorderStyle type="line" width="1.5" color="#000000"/>
          <y:NodeLabel fontFamily="Arial" fontSize="15" fontStyle="plain"
                       alignment="center">NoOutsideLoads</y:NodeLabel>
          <y:Shape type="roundrectangle"/>
        </y:ShapeNode>
      </data>
    </node>

    <!-- bc_nol_pad: taller (h=70) and wide (w=160) for comfortable text spacing.
         Routing: bc_per→Run uses arm at x=485 (left of left=501); no conflict.
                  bc_0ds→Run uses arm at x=673 (right of right=661); no conflict. -->
    <node id="bc_nol_pad">
      <data key="d6">
        <y:ShapeNode>
          <y:Geometry x="501.00" y="559.45" width="160" height="70"/>
          <y:Fill color="#E8E8E8" transparent="false"/>
          <y:BorderStyle type="line" width="1.5" color="#000000"/>
          <y:NodeLabel fontFamily="Arial" fontSize="15" fontStyle="plain"
                       alignment="center">NoOutsideLoads
(via padding)</y:NodeLabel>
          <y:Shape type="roundrectangle"/>
        </y:ShapeNode>
      </data>
    </node>

    <!-- BMI: run — cx=516; BCs→Run bus y = (629.45 + 677.45) / 2 = 653.45 -->
    <node id="n0">
      <data key="d6">
        <y:ShapeNode>
          <y:Geometry x="461.00" y="677.45" width="110" height="44"/>
          <y:Fill color="#E8E8E8" transparent="false"/>
          <y:BorderStyle type="line" width="2.5" color="#000000"/>
          <y:NodeLabel fontFamily="Arial" fontSize="15" fontStyle="bold"
                       alignment="center">Run</y:NodeLabel>
          <y:Shape type="ellipse"/>
        </y:ShapeNode>
      </data>
    </node>

    <!-- BMI: output (optional) cx=516 -->
    <node id="n_output">
      <data key="d6">
        <y:ShapeNode>
          <y:Geometry x="461.00" y="741.45" width="110" height="44"/>
          <y:Fill color="#E8E8E8" transparent="false"/>
          <y:BorderStyle type="dashed" width="1.5" color="#000000"/>
          <y:NodeLabel fontFamily="Arial" fontSize="15" fontStyle="plain"
                       alignment="center">Output</y:NodeLabel>
          <y:Shape type="ellipse"/>
        </y:ShapeNode>
      </data>
    </node>

    <!-- BMI: finalize  cx=516 -->
    <node id="n14">
      <data key="d6">
        <y:ShapeNode>
          <y:Geometry x="461.00" y="805.45" width="110" height="44"/>
          <y:Fill color="#E8E8E8" transparent="false"/>
          <y:BorderStyle type="line" width="2.5" color="#000000"/>
          <y:NodeLabel fontFamily="Arial" fontSize="15" fontStyle="bold"
                       alignment="center">Finalize</y:NodeLabel>
          <y:Shape type="ellipse"/>
        </y:ShapeNode>
      </data>
    </node>

    <!-- ── Edges ─────────────────────────────────────────────────────────────── -->

    <!-- Input → Initialize (straight vertical, both cx=516) -->
    <edge id="e0" source="n8" target="n7">
      <data key="d10"><y:PolyLineEdge>
        <y:LineStyle type="line" width="1.5" color="#000000"/>
        <y:Arrows source="none" target="standard"/>
      </y:PolyLineEdge></data>
    </edge>

    <!-- Initialize (cx=516) → solution methods
         bus y = (263.89 + 323.66) / 2 = 293.78 -->
    <edge id="e1" source="n7" target="n3">
      <data key="d10"><y:PolyLineEdge>
        <y:LineStyle type="line" width="1.5" color="#000000"/>
        <y:Arrows source="none" target="standard"/>
        <y:Point x="516.00" y="293.78"/>
        <y:Point x="200.00" y="293.78"/>
      </y:PolyLineEdge></data>
    </edge>
    <edge id="e2" source="n7" target="n2">
      <data key="d10"><y:PolyLineEdge>
        <y:LineStyle type="line" width="1.5" color="#000000"/>
        <y:Arrows source="none" target="standard"/>
        <y:Point x="516.00" y="293.78"/>
        <y:Point x="450.00" y="293.78"/>
      </y:PolyLineEdge></data>
    </edge>
    <edge id="e3" source="n7" target="n4">
      <data key="d10"><y:PolyLineEdge>
        <y:LineStyle type="line" width="1.5" color="#000000"/>
        <y:Arrows source="none" target="standard"/>
        <y:Point x="516.00" y="293.78"/>
        <y:Point x="660.00" y="293.78"/>
      </y:PolyLineEdge></data>
    </edge>
    <edge id="e4" source="n7" target="n1">
      <data key="d10"><y:PolyLineEdge>
        <y:LineStyle type="line" width="1.5" color="#000000"/>
        <y:Arrows source="none" target="standard"/>
        <y:Point x="516.00" y="293.78"/>
        <y:Point x="825.00" y="293.78"/>
      </y:PolyLineEdge></data>
    </edge>

    <!-- Solution methods → BCs
         Methods bottom=399.66; BC Row 1 top=459.45.
         Methods→BCs bus y = (399.66 + 459.45) / 2 = 429.56

         SAS_NG (200) and SAS (450) converge on bc_nol (325).
         FFT (660) →left→ bc_per (516).
         FD  (825) fans: left to bc_per (516), bc_0ds (646), bc_mir (771);
                         right to bc_0ss (871), bc_0ms (976).
         Overlapping bus segments on the left side are intentional
         shared-bus notation (multiple sources into one BC). -->
    <edge id="e5" source="n3" target="bc_nol">
      <data key="d10"><y:PolyLineEdge>
        <y:LineStyle type="line" width="1.5" color="#000000"/>
        <y:Arrows source="none" target="standard"/>
        <y:Point x="200.00" y="429.56"/>
        <y:Point x="325.00" y="429.56"/>
      </y:PolyLineEdge></data>
    </edge>
    <edge id="e6" source="n2" target="bc_nol">
      <data key="d10"><y:PolyLineEdge>
        <y:LineStyle type="line" width="1.5" color="#000000"/>
        <y:Arrows source="none" target="standard"/>
        <y:Point x="450.00" y="429.56"/>
        <y:Point x="325.00" y="429.56"/>
      </y:PolyLineEdge></data>
    </edge>
    <edge id="e7" source="n4" target="bc_per">
      <data key="d10"><y:PolyLineEdge>
        <y:LineStyle type="line" width="1.5" color="#000000"/>
        <y:Arrows source="none" target="standard"/>
        <y:Point x="660.00" y="429.56"/>
        <y:Point x="516.00" y="429.56"/>
      </y:PolyLineEdge></data>
    </edge>
    <edge id="e8" source="n1" target="bc_per">
      <data key="d10"><y:PolyLineEdge>
        <y:LineStyle type="line" width="1.5" color="#000000"/>
        <y:Arrows source="none" target="standard"/>
        <y:Point x="825.00" y="429.56"/>
        <y:Point x="516.00" y="429.56"/>
      </y:PolyLineEdge></data>
    </edge>
    <edge id="e9" source="n1" target="bc_0ds">
      <data key="d10"><y:PolyLineEdge>
        <y:LineStyle type="line" width="1.5" color="#000000"/>
        <y:Arrows source="none" target="standard"/>
        <y:Point x="825.00" y="429.56"/>
        <y:Point x="646.00" y="429.56"/>
      </y:PolyLineEdge></data>
    </edge>
    <edge id="e10" source="n1" target="bc_mir">
      <data key="d10"><y:PolyLineEdge>
        <y:LineStyle type="line" width="1.5" color="#000000"/>
        <y:Arrows source="none" target="standard"/>
        <y:Point x="825.00" y="429.56"/>
        <y:Point x="771.00" y="429.56"/>
      </y:PolyLineEdge></data>
    </edge>
    <edge id="e11" source="n1" target="bc_0ss">
      <data key="d10"><y:PolyLineEdge>
        <y:LineStyle type="line" width="1.5" color="#000000"/>
        <y:Arrows source="none" target="standard"/>
        <y:Point x="825.00" y="429.56"/>
        <y:Point x="871.00" y="429.56"/>
      </y:PolyLineEdge></data>
    </edge>
    <edge id="e12" source="n1" target="bc_0ms">
      <data key="d10"><y:PolyLineEdge>
        <y:LineStyle type="line" width="1.5" color="#000000"/>
        <y:Arrows source="none" target="standard"/>
        <y:Point x="825.00" y="429.56"/>
        <y:Point x="976.00" y="429.56"/>
      </y:PolyLineEdge></data>
    </edge>

    <!-- Row 1 BCs → bc_nol_pad (Row 2)
         Row1 bottom=519.45; bc_nol_pad top=559.45.
         Row1→Row2 bus y = (519.45 + 559.45) / 2 = 539.45
         bc_per (516) →right 65px→ bc_nol_pad (581).
         bc_0ds (646) →left  65px→ bc_nol_pad (581). Symmetric.
         The bracket detour arms for bc_per→Run and bc_0ds→Run also
         use y=539.45, creating clean T-junctions at each BC's cx. -->
    <edge id="e20" source="bc_per" target="bc_nol_pad">
      <data key="d10"><y:PolyLineEdge>
        <y:LineStyle type="line" width="1.5" color="#000000"/>
        <y:Arrows source="none" target="standard"/>
        <y:Point x="516.00" y="539.45"/>
        <y:Point x="581.00" y="539.45"/>
      </y:PolyLineEdge></data>
    </edge>
    <edge id="e21" source="bc_0ds" target="bc_nol_pad">
      <data key="d10"><y:PolyLineEdge>
        <y:LineStyle type="line" width="1.5" color="#000000"/>
        <y:Arrows source="none" target="standard"/>
        <y:Point x="646.00" y="539.45"/>
        <y:Point x="581.00" y="539.45"/>
      </y:PolyLineEdge></data>
    </edge>

    <!-- BCs → Run  (Run cx=516; BCs→Run bus y=653.45)
         bus y = (bc_nol_pad bottom=629.45 + Run top=677.45) / 2 = 653.45

         bc_per→Run: bracket detour LEFT of bc_nol_pad (arm at x=485 < left=501).
           Horizontal at y=539.45 (same level as Row1→Row2 bus) — clean T-junction
           at (516, 539.45) shared with bc_per→bc_nol_pad edge.
         bc_0ds→Run: bracket detour RIGHT of bc_nol_pad (arm at x=673 > right=661).
           Horizontal at y=539.45 — clean T-junction at (646, 539.45) shared with
           bc_0ds→bc_nol_pad edge.
         All other BCs go straight down to bus_y, then left/right to x=516. -->
    <edge id="e14" source="bc_per" target="n0">
      <data key="d10"><y:PolyLineEdge>
        <y:LineStyle type="line" width="1.5" color="#000000"/>
        <y:Arrows source="none" target="standard"/>
        <y:Point x="516.00" y="539.45"/>
        <y:Point x="485.00" y="539.45"/>
        <y:Point x="485.00" y="653.45"/>
        <y:Point x="516.00" y="653.45"/>
      </y:PolyLineEdge></data>
    </edge>
    <edge id="e18" source="bc_0ds" target="n0">
      <data key="d10"><y:PolyLineEdge>
        <y:LineStyle type="line" width="1.5" color="#000000"/>
        <y:Arrows source="none" target="standard"/>
        <y:Point x="646.00" y="539.45"/>
        <y:Point x="673.00" y="539.45"/>
        <y:Point x="673.00" y="653.45"/>
        <y:Point x="516.00" y="653.45"/>
      </y:PolyLineEdge></data>
    </edge>
    <edge id="e22" source="bc_nol_pad" target="n0">
      <data key="d10"><y:PolyLineEdge>
        <y:LineStyle type="line" width="1.5" color="#000000"/>
        <y:Arrows source="none" target="standard"/>
        <y:Point x="581.00" y="653.45"/>
        <y:Point x="516.00" y="653.45"/>
      </y:PolyLineEdge></data>
    </edge>
    <edge id="e13" source="bc_nol" target="n0">
      <data key="d10"><y:PolyLineEdge>
        <y:LineStyle type="line" width="1.5" color="#000000"/>
        <y:Arrows source="none" target="standard"/>
        <y:Point x="325.00" y="653.45"/>
        <y:Point x="516.00" y="653.45"/>
      </y:PolyLineEdge></data>
    </edge>
    <edge id="e15" source="bc_mir" target="n0">
      <data key="d10"><y:PolyLineEdge>
        <y:LineStyle type="line" width="1.5" color="#000000"/>
        <y:Arrows source="none" target="standard"/>
        <y:Point x="771.00" y="653.45"/>
        <y:Point x="516.00" y="653.45"/>
      </y:PolyLineEdge></data>
    </edge>
    <edge id="e16" source="bc_0ss" target="n0">
      <data key="d10"><y:PolyLineEdge>
        <y:LineStyle type="line" width="1.5" color="#000000"/>
        <y:Arrows source="none" target="standard"/>
        <y:Point x="871.00" y="653.45"/>
        <y:Point x="516.00" y="653.45"/>
      </y:PolyLineEdge></data>
    </edge>
    <edge id="e17" source="bc_0ms" target="n0">
      <data key="d10"><y:PolyLineEdge>
        <y:LineStyle type="line" width="1.5" color="#000000"/>
        <y:Arrows source="none" target="standard"/>
        <y:Point x="976.00" y="653.45"/>
        <y:Point x="516.00" y="653.45"/>
      </y:PolyLineEdge></data>
    </edge>

    <!-- Run → output() (dashed: optional step) -->
    <edge id="e19" source="n0" target="n_output">
      <data key="d10"><y:PolyLineEdge>
        <y:LineStyle type="dashed" width="1.5" color="#000000"/>
        <y:Arrows source="none" target="standard"/>
      </y:PolyLineEdge></data>
    </edge>

    <!-- output() → Finalize (dashed: optional step) -->
    <edge id="e23" source="n_output" target="n14">
      <data key="d10"><y:PolyLineEdge>
        <y:LineStyle type="dashed" width="1.5" color="#000000"/>
        <y:Arrows source="none" target="standard"/>
      </y:PolyLineEdge></data>
    </edge>

  </graph>
</graphml>
