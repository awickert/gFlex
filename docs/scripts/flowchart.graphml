<?xml version="1.0" encoding="UTF-8"?>
<graphml xmlns="http://graphml.graphdrawing.org/graphml"
         xmlns:y="http://www.yworks.com/xml/graphml">
  <key id="d6"  for="node" yfiles.type="nodegraphics"/>
  <key id="d10" for="edge" yfiles.type="edgegraphics"/>
  <graph id="G" edgedefault="directed">

    <!-- Input -->
    <node id="n8">
      <data key="d6">
        <y:ShapeNode>
          <y:Geometry x="442.50" y="59.66" width="210" height="84"/>
          <y:Fill color="#E8E8E8" transparent="false"/>
          <y:BorderStyle type="line" width="1.5" color="#000000"/>
          <y:NodeLabel fontFamily="Arial" fontSize="15" fontStyle="plain"
                       alignment="center">Loads,
elastic properties</y:NodeLabel>
          <y:Shape type="diamond"/>
        </y:ShapeNode>
      </data>
    </node>

    <!-- BMI: initialize -->
    <node id="n7">
      <data key="d6">
        <y:ShapeNode>
          <y:Geometry x="473.50" y="203.89" width="148" height="60"/>
          <y:Fill color="#E8E8E8" transparent="false"/>
          <y:BorderStyle type="line" width="2.5" color="#000000"/>
          <y:NodeLabel fontFamily="Arial" fontSize="15" fontStyle="bold"
                       alignment="center">Initialize
(1D or 2D)</y:NodeLabel>
          <y:Shape type="ellipse"/>
        </y:ShapeNode>
      </data>
    </node>

    <!-- Background band: solution method row -->
    <!-- Methods span x=55 to x=1040; band adds 12px padding each side -->
    <node id="bg_methods">
      <data key="d6">
        <y:ShapeNode>
          <y:Geometry x="43.00" y="311.66" width="1009.00" height="100.00"/>
          <y:Fill color="#F2F2F2" transparent="false"/>
          <y:BorderStyle type="line" width="1.0" color="#BBBBBB"/>
          <y:NodeLabel fontFamily="Arial" fontSize="11" fontStyle="italic"
                       alignment="left" textColor="#888888"
                       modelName="internal" modelPosition="tl">Solution Method</y:NodeLabel>
          <y:Shape type="roundrectangle"/>
        </y:ShapeNode>
      </data>
    </node>

    <!-- Solution methods (left→right: SAS_NG, SAS, FFT, FD) -->
    <node id="n3">
      <data key="d6">
        <y:ShapeNode>
          <y:Geometry x="55.00" y="323.66" width="215" height="76"/>
          <y:Fill color="#E8E8E8" transparent="false"/>
          <y:BorderStyle type="line" width="1.5" color="#000000"/>
          <y:NodeLabel fontFamily="Arial" fontSize="15" fontStyle="plain"
                       alignment="center">Superposition of
Analytical Solutions,
no grid (SAS_NG)</y:NodeLabel>
          <y:Shape type="roundrectangle"/>
        </y:ShapeNode>
      </data>
    </node>

    <node id="n2">
      <data key="d6">
        <y:ShapeNode>
          <y:Geometry x="350.00" y="323.66" width="205" height="76"/>
          <y:Fill color="#E8E8E8" transparent="false"/>
          <y:BorderStyle type="line" width="1.5" color="#000000"/>
          <y:NodeLabel fontFamily="Arial" fontSize="15" fontStyle="plain"
                       alignment="center">Superposition of
Analytical Solutions
(SAS)</y:NodeLabel>
          <y:Shape type="roundrectangle"/>
        </y:ShapeNode>
      </data>
    </node>

    <node id="n4">
      <data key="d6">
        <y:ShapeNode>
          <y:Geometry x="650.00" y="323.66" width="120" height="76"/>
          <y:Fill color="#E8E8E8" transparent="false"/>
          <y:BorderStyle type="line" width="1.5" color="#000000"/>
          <y:NodeLabel fontFamily="Arial" fontSize="15" fontStyle="plain"
                       alignment="center">Spectral
(FFT)</y:NodeLabel>
          <y:Shape type="roundrectangle"/>
        </y:ShapeNode>
      </data>
    </node>

    <node id="n1">
      <data key="d6">
        <y:ShapeNode>
          <y:Geometry x="870.00" y="323.66" width="170" height="76"/>
          <y:Fill color="#E8E8E8" transparent="false"/>
          <y:BorderStyle type="line" width="1.5" color="#000000"/>
          <y:NodeLabel fontFamily="Arial" fontSize="15" fontStyle="plain"
                       alignment="center">Finite Difference
(FD)</y:NodeLabel>
          <y:Shape type="roundrectangle"/>
        </y:ShapeNode>
      </data>
    </node>

    <!-- Background band: boundary condition row -->
    <!-- BCs span x=230 to x=1670; band adds 12px padding each side -->
    <node id="bg_bcs">
      <data key="d6">
        <y:ShapeNode>
          <y:Geometry x="218.00" y="447.45" width="1464.00" height="84.00"/>
          <y:Fill color="#F2F2F2" transparent="false"/>
          <y:BorderStyle type="line" width="1.0" color="#BBBBBB"/>
          <y:NodeLabel fontFamily="Arial" fontSize="11" fontStyle="italic"
                       alignment="left" textColor="#888888"
                       modelName="internal" modelPosition="tl">Boundary Condition</y:NodeLabel>
          <y:Shape type="roundrectangle"/>
        </y:ShapeNode>
      </data>
    </node>

    <!-- Boundary conditions.
         bc_nol sits between SAS_NG (cx=162.5) and SAS (cx=452.5): cx=307.5
         bc_per sits between FFT (cx=710) and FD (cx=955): cx=832.5
         bc_mir, bc_0ss, bc_0ms, bc_0ds sit to the right of FD. -->
    <node id="bc_nol">
      <data key="d6">
        <y:ShapeNode>
          <y:Geometry x="230.00" y="459.45" width="155" height="60"/>
          <y:Fill color="#E8E8E8" transparent="false"/>
          <y:BorderStyle type="line" width="1.5" color="#000000"/>
          <y:NodeLabel fontFamily="Arial" fontSize="13" fontStyle="plain"
                       alignment="center">NoOutsideLoads</y:NodeLabel>
          <y:Shape type="roundrectangle"/>
        </y:ShapeNode>
      </data>
    </node>

    <node id="bc_per">
      <data key="d6">
        <y:ShapeNode>
          <y:Geometry x="782.50" y="459.45" width="100" height="60"/>
          <y:Fill color="#E8E8E8" transparent="false"/>
          <y:BorderStyle type="line" width="1.5" color="#000000"/>
          <y:NodeLabel fontFamily="Arial" fontSize="13" fontStyle="plain"
                       alignment="center">Periodic</y:NodeLabel>
          <y:Shape type="roundrectangle"/>
        </y:ShapeNode>
      </data>
    </node>

    <node id="bc_mir">
      <data key="d6">
        <y:ShapeNode>
          <y:Geometry x="1080.00" y="459.45" width="90" height="60"/>
          <y:Fill color="#E8E8E8" transparent="false"/>
          <y:BorderStyle type="line" width="1.5" color="#000000"/>
          <y:NodeLabel fontFamily="Arial" fontSize="13" fontStyle="plain"
                       alignment="center">Mirror</y:NodeLabel>
          <y:Shape type="roundrectangle"/>
        </y:ShapeNode>
      </data>
    </node>

    <node id="bc_0ss">
      <data key="d6">
        <y:ShapeNode>
          <y:Geometry x="1210.00" y="459.45" width="105" height="60"/>
          <y:Fill color="#E8E8E8" transparent="false"/>
          <y:BorderStyle type="line" width="1.5" color="#000000"/>
          <y:NodeLabel fontFamily="Arial" fontSize="13" fontStyle="plain"
                       alignment="center">0Slope
0Shear</y:NodeLabel>
          <y:Shape type="roundrectangle"/>
        </y:ShapeNode>
      </data>
    </node>

    <node id="bc_0ms">
      <data key="d6">
        <y:ShapeNode>
          <y:Geometry x="1355.00" y="459.45" width="120" height="60"/>
          <y:Fill color="#E8E8E8" transparent="false"/>
          <y:BorderStyle type="line" width="1.5" color="#000000"/>
          <y:NodeLabel fontFamily="Arial" fontSize="13" fontStyle="plain"
                       alignment="center">0Moment
0Shear</y:NodeLabel>
          <y:Shape type="roundrectangle"/>
        </y:ShapeNode>
      </data>
    </node>

    <node id="bc_0ds">
      <data key="d6">
        <y:ShapeNode>
          <y:Geometry x="1515.00" y="459.45" width="155" height="60"/>
          <y:Fill color="#E8E8E8" transparent="false"/>
          <y:BorderStyle type="line" width="1.5" color="#000000"/>
          <y:NodeLabel fontFamily="Arial" fontSize="13" fontStyle="plain"
                       alignment="center">0Displacement
0Slope</y:NodeLabel>
          <y:Shape type="roundrectangle"/>
        </y:ShapeNode>
      </data>
    </node>

    <!-- BMI: run — centered on BC span: (307.5+1592.5)/2 = 950 -->
    <node id="n0">
      <data key="d6">
        <y:ShapeNode>
          <y:Geometry x="895.00" y="577.45" width="110" height="44"/>
          <y:Fill color="#E8E8E8" transparent="false"/>
          <y:BorderStyle type="line" width="2.5" color="#000000"/>
          <y:NodeLabel fontFamily="Arial" fontSize="15" fontStyle="bold"
                       alignment="center">Run</y:NodeLabel>
          <y:Shape type="ellipse"/>
        </y:ShapeNode>
      </data>
    </node>

    <!-- BMI: finalize -->
    <node id="n14">
      <data key="d6">
        <y:ShapeNode>
          <y:Geometry x="895.00" y="678.56" width="110" height="44"/>
          <y:Fill color="#E8E8E8" transparent="false"/>
          <y:BorderStyle type="line" width="2.5" color="#000000"/>
          <y:NodeLabel fontFamily="Arial" fontSize="15" fontStyle="bold"
                       alignment="center">Finalize</y:NodeLabel>
          <y:Shape type="ellipse"/>
        </y:ShapeNode>
      </data>
    </node>

    <!-- Edges: input → initialize (straight vertical) -->
    <edge id="e0" source="n8" target="n7">
      <data key="d10"><y:PolyLineEdge>
        <y:LineStyle type="line" width="1.5" color="#000000"/>
        <y:Arrows source="none" target="standard"/>
      </y:PolyLineEdge></data>
    </edge>

    <!-- Edges: initialize → solution methods
         Initialize cx=547.5; bus y=(263.89+323.66)/2=293.78 -->
    <edge id="e1" source="n7" target="n3">
      <data key="d10"><y:PolyLineEdge>
        <y:LineStyle type="line" width="1.5" color="#000000"/>
        <y:Arrows source="none" target="standard"/>
        <y:Point x="547.50" y="293.78"/>
        <y:Point x="162.50" y="293.78"/>
      </y:PolyLineEdge></data>
    </edge>
    <edge id="e2" source="n7" target="n2">
      <data key="d10"><y:PolyLineEdge>
        <y:LineStyle type="line" width="1.5" color="#000000"/>
        <y:Arrows source="none" target="standard"/>
        <y:Point x="547.50" y="293.78"/>
        <y:Point x="452.50" y="293.78"/>
      </y:PolyLineEdge></data>
    </edge>
    <edge id="e3" source="n7" target="n4">
      <data key="d10"><y:PolyLineEdge>
        <y:LineStyle type="line" width="1.5" color="#000000"/>
        <y:Arrows source="none" target="standard"/>
        <y:Point x="547.50" y="293.78"/>
        <y:Point x="710.00" y="293.78"/>
      </y:PolyLineEdge></data>
    </edge>
    <edge id="e4" source="n7" target="n1">
      <data key="d10"><y:PolyLineEdge>
        <y:LineStyle type="line" width="1.5" color="#000000"/>
        <y:Arrows source="none" target="standard"/>
        <y:Point x="547.50" y="293.78"/>
        <y:Point x="955.00" y="293.78"/>
      </y:PolyLineEdge></data>
    </edge>

    <!-- Edges: solution methods → boundary conditions
         Bus y=(399.66+459.45)/2=429.56
         bc_nol (cx=307.5) is between SAS_NG (cx=162.5) and SAS (cx=452.5):
           SAS_NG goes RIGHT, SAS goes LEFT — no segment overlap.
         bc_per (cx=832.5) is between FFT (cx=710) and FD (cx=955):
           FFT goes RIGHT, FD goes LEFT — no segment overlap.
         bc_mir..bc_0ds are right of FD (cx=955): FD fans RIGHT — comb, no cross-method overlap. -->
    <edge id="e5" source="n3" target="bc_nol">
      <data key="d10"><y:PolyLineEdge>
        <y:LineStyle type="line" width="1.5" color="#000000"/>
        <y:Arrows source="none" target="standard"/>
        <y:Point x="162.50" y="429.56"/>
        <y:Point x="307.50" y="429.56"/>
      </y:PolyLineEdge></data>
    </edge>
    <edge id="e6" source="n2" target="bc_nol">
      <data key="d10"><y:PolyLineEdge>
        <y:LineStyle type="line" width="1.5" color="#000000"/>
        <y:Arrows source="none" target="standard"/>
        <y:Point x="452.50" y="429.56"/>
        <y:Point x="307.50" y="429.56"/>
      </y:PolyLineEdge></data>
    </edge>
    <edge id="e7" source="n4" target="bc_per">
      <data key="d10"><y:PolyLineEdge>
        <y:LineStyle type="line" width="1.5" color="#000000"/>
        <y:Arrows source="none" target="standard"/>
        <y:Point x="710.00" y="429.56"/>
        <y:Point x="832.50" y="429.56"/>
      </y:PolyLineEdge></data>
    </edge>
    <edge id="e8" source="n1" target="bc_per">
      <data key="d10"><y:PolyLineEdge>
        <y:LineStyle type="line" width="1.5" color="#000000"/>
        <y:Arrows source="none" target="standard"/>
        <y:Point x="955.00" y="429.56"/>
        <y:Point x="832.50" y="429.56"/>
      </y:PolyLineEdge></data>
    </edge>
    <edge id="e9" source="n1" target="bc_mir">
      <data key="d10"><y:PolyLineEdge>
        <y:LineStyle type="line" width="1.5" color="#000000"/>
        <y:Arrows source="none" target="standard"/>
        <y:Point x="955.00" y="429.56"/>
        <y:Point x="1125.00" y="429.56"/>
      </y:PolyLineEdge></data>
    </edge>
    <edge id="e10" source="n1" target="bc_0ss">
      <data key="d10"><y:PolyLineEdge>
        <y:LineStyle type="line" width="1.5" color="#000000"/>
        <y:Arrows source="none" target="standard"/>
        <y:Point x="955.00" y="429.56"/>
        <y:Point x="1262.50" y="429.56"/>
      </y:PolyLineEdge></data>
    </edge>
    <edge id="e11" source="n1" target="bc_0ms">
      <data key="d10"><y:PolyLineEdge>
        <y:LineStyle type="line" width="1.5" color="#000000"/>
        <y:Arrows source="none" target="standard"/>
        <y:Point x="955.00" y="429.56"/>
        <y:Point x="1415.00" y="429.56"/>
      </y:PolyLineEdge></data>
    </edge>
    <edge id="e12" source="n1" target="bc_0ds">
      <data key="d10"><y:PolyLineEdge>
        <y:LineStyle type="line" width="1.5" color="#000000"/>
        <y:Arrows source="none" target="standard"/>
        <y:Point x="955.00" y="429.56"/>
        <y:Point x="1592.50" y="429.56"/>
      </y:PolyLineEdge></data>
    </edge>

    <!-- Edges: boundary conditions → run
         Run cx=950; bus y=(519.45+577.45)/2=548.45
         bc_nol (307.5) and bc_per (832.5) are left of Run — go right.
         bc_mir..bc_0ds are right of Run — go left. -->
    <edge id="e13" source="bc_nol" target="n0">
      <data key="d10"><y:PolyLineEdge>
        <y:LineStyle type="line" width="1.5" color="#000000"/>
        <y:Arrows source="none" target="standard"/>
        <y:Point x="307.50" y="548.45"/>
        <y:Point x="950.00" y="548.45"/>
      </y:PolyLineEdge></data>
    </edge>
    <edge id="e14" source="bc_per" target="n0">
      <data key="d10"><y:PolyLineEdge>
        <y:LineStyle type="line" width="1.5" color="#000000"/>
        <y:Arrows source="none" target="standard"/>
        <y:Point x="832.50" y="548.45"/>
        <y:Point x="950.00" y="548.45"/>
      </y:PolyLineEdge></data>
    </edge>
    <edge id="e15" source="bc_mir" target="n0">
      <data key="d10"><y:PolyLineEdge>
        <y:LineStyle type="line" width="1.5" color="#000000"/>
        <y:Arrows source="none" target="standard"/>
        <y:Point x="1125.00" y="548.45"/>
        <y:Point x="950.00" y="548.45"/>
      </y:PolyLineEdge></data>
    </edge>
    <edge id="e16" source="bc_0ss" target="n0">
      <data key="d10"><y:PolyLineEdge>
        <y:LineStyle type="line" width="1.5" color="#000000"/>
        <y:Arrows source="none" target="standard"/>
        <y:Point x="1262.50" y="548.45"/>
        <y:Point x="950.00" y="548.45"/>
      </y:PolyLineEdge></data>
    </edge>
    <edge id="e17" source="bc_0ms" target="n0">
      <data key="d10"><y:PolyLineEdge>
        <y:LineStyle type="line" width="1.5" color="#000000"/>
        <y:Arrows source="none" target="standard"/>
        <y:Point x="1415.00" y="548.45"/>
        <y:Point x="950.00" y="548.45"/>
      </y:PolyLineEdge></data>
    </edge>
    <edge id="e18" source="bc_0ds" target="n0">
      <data key="d10"><y:PolyLineEdge>
        <y:LineStyle type="line" width="1.5" color="#000000"/>
        <y:Arrows source="none" target="standard"/>
        <y:Point x="1592.50" y="548.45"/>
        <y:Point x="950.00" y="548.45"/>
      </y:PolyLineEdge></data>
    </edge>

    <!-- Edges: run → finalize (straight vertical) -->
    <edge id="e19" source="n0" target="n14">
      <data key="d10"><y:PolyLineEdge>
        <y:LineStyle type="line" width="1.5" color="#000000"/>
        <y:Arrows source="none" target="standard"/>
      </y:PolyLineEdge></data>
    </edge>

  </graph>
</graphml>
